<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidKErrorLogPackage">

    <Groups>
      <Group guid="guidKErrorLogCmdSet" id="KErrorLogMenuGroup" priority="0x0620">
        <Parent guid="guidVsMainMenu" id="IDM_EXTENSIONS_MENU" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidKErrorLogCmdSet" id="CmdShow" priority="0x0100" type="Button">
        <Parent guid="guidKErrorLogCmdSet" id="KErrorLogMenuGroup" />
        <Strings>
          <ButtonText>K-ErrorLog (エラーログ)を開く</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <!-- 拡張機能 メニュー。ビルド ツールの vsshlids.h に無いので、値を書く -->
    <GuidSymbol name="guidVsMainMenu" value="{D309F791-903F-11D0-9EFC-00A0C911004F}">
      <IDSymbol name="IDM_EXTENSIONS_MENU" value="0x0091" />
    </GuidSymbol>

    <GuidSymbol name="guidKErrorLogPackage" value="{b28d48b3-38dd-4f95-8cac-6cbb12d69f52}" />

    <GuidSymbol name="guidKErrorLogCmdSet" value="{40b296ef-05dd-45f4-9119-227edb4904c0}">
      <IDSymbol name="KErrorLogMenuGroup" value="0x1000" />
      <IDSymbol name="CmdShow" value="0x0100" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
