<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidKCppAssistPackage">

    <Groups>
      <Group guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" priority="0x0610">
        <Parent guid="guidVsMainMenu" id="IDM_EXTENSIONS_MENU" />
      </Group>
      <!-- プロジェクト・ソリューションを右クリックしたときのメニュー -->
      <Group guid="guidKCppAssistCmdSet" id="KCppAssistProjGroup" priority="0x0710">
        <Parent guid="guidVsMainMenu" id="IDM_VS_CTXT_PROJNODE" />
      </Group>
      <Group guid="guidKCppAssistCmdSet" id="KCppAssistSolnGroup" priority="0x0710">
        <Parent guid="guidVsMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidKCppAssistCmdSet" id="CmdHelp" priority="0x0102" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist の使い方...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdTidyProject" priority="0x0110" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist: #include を整理（プロジェクト全体）</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdUnusedProject" priority="0x0111" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist: 使っていない #include を消す（プロジェクト全体）</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdTidyFile" priority="0x0112" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist: このファイルの #include を整理</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdForward" priority="0x0113" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist: #include を前方宣言にする</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdSwitch" priority="0x0114" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist: switch の足りない case を足す</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdCtor" priority="0x0115" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist: メンバーからコンストラクターを作る</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdOverride" priority="0x0116" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist: 基底クラスの仮想関数を override する</ButtonText>
        </Strings>
      </Button>
      <!-- 3 つのコマンドは、メニューには出さない(キーだけで使う。キーは設定で変えられる) -->
      <Button guid="guidKCppAssistCmdSet" id="CmdLocal" priority="0x0100" type="Button">
        <Strings>
          <ButtonText>ローカル変数に型を付ける</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdMember" priority="0x0101" type="Button">
        <Strings>
          <ButtonText>メンバー変数として宣言する</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdAccessor" priority="0x0102" type="Button">
        <Strings>
          <ButtonText>ゲッター・セッターを作る</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdInclude" priority="0x0104" type="Button">
        <Strings>
          <ButtonText>#include を足す</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdSync" priority="0x0105" type="Button">
        <Strings>
          <ButtonText>宣言と定義の引数を合わせる</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdCreate" priority="0x0106" type="Button">
        <Strings>
          <ButtonText>宣言・定義の相手を作る</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdMove" priority="0x0109" type="Button">
        <Strings>
          <ButtonText>関数を ヘッダー ⇄ cpp に移す</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdRename" priority="0x0108" type="Button">
        <Strings>
          <ButtonText>ファイル名をまとめて変える</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdErrorLog" priority="0x0107" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-ErrorLog (エラーログ)を開く</ButtonText>
        </Strings>
      </Button>
      <!-- 拡張機能 メニューに出るのは、設定画面を開くものと、エラーログを開くものの 2 つ -->
      <Button guid="guidKCppAssistCmdSet" id="CmdSettings" priority="0x0103" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-CppAssist の設定...</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdTidyProject" priority="0x0001"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistProjGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdUnusedProject" priority="0x0002"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistProjGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdTidyProject" priority="0x0001"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistSolnGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdUnusedProject" priority="0x0002"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistSolnGroup" /></CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdLocal" editor="guidVSStd97" key1="Q" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdMember" editor="guidVSStd97" key1="W" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdAccessor" editor="guidVSStd97" key1="E" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdInclude" editor="guidVSStd97" key1="F" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdRename" editor="guidVSStd97" key1="N" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdSync" editor="guidVSStd97" key1="G" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdCreate" editor="guidVSStd97" key1="R" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdMove" editor="guidVSStd97" key1="M" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdForward" editor="guidVSStd97" key1="D" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdSwitch" editor="guidVSStd97" key1="Z" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdCtor" editor="guidVSStd97" key1="C" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdOverride" editor="guidVSStd97" key1="O" mod1="Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidVsMainMenu" value="{D309F791-903F-11D0-9EFC-00A0C911004F}">
      <IDSymbol name="IDM_EXTENSIONS_MENU" value="0x0091" />
