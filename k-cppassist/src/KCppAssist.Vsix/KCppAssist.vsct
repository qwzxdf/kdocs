<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidKCppAssistPackage">

    <Groups>
      <Group guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" priority="0x0610">
        <Parent guid="guidVsMainMenu" id="IDM_EXTENSIONS_MENU" />
      </Group>
      <!-- プロジェクト・ソリューションを右クリックしたときのメニュー -->
      <Group guid="guidKCppAssistCmdSet" id="KCppAssistProjGroup" priority="0x0710">
        <Parent guid="guidVsMainMenu" id="IDM_VS_CTXT_PROJNODE" />
      </Group>
      <Group guid="guidKCppAssistCmdSet" id="KCppAssistSolnGroup" priority="0x0710">
        <Parent guid="guidVsMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
      </Group>
      <!-- エディターを右クリックしたときのメニュー -->
      <Group guid="guidKCppAssistCmdSet" id="KCppAssistEditGroup" priority="0x0600">
        <Parent guid="guidVsMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidKCppAssistCmdSet" id="CmdHelp" priority="0x0102" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: 使い方...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdTidyProject" priority="0x0110" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: #include を整理（プロジェクト全体）</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdUnusedProject" priority="0x0111" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: 使っていない #include を消す（プロジェクト全体）</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdTidyFile" priority="0x0112" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: このファイルの #include を整理</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdForward" priority="0x0113" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: #include を前方宣言にする (Forward / Alt+F)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdCtor" priority="0x0115" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: メンバーからコンストラクターを作る (Constructor / Alt+C)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdOverride" priority="0x0116" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: 基底クラスの仮想関数を override する (Override / Alt+O)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdUsage" priority="0x0117" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: 呼び出しから関数を作る (Usage / Alt+U)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdEncoding" priority="0x0118" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: ファイルの文字コードをそろえる...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdRefactor" priority="0x0119" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: この位置の書き換え・生成の一覧... (eXplore / Alt+X)</ButtonText>
        </Strings>
      </Button>
      <!-- 3 つのコマンドは、メニューには出さない(キーだけで使う。キーは設定で変えられる) -->
      <Button guid="guidKCppAssistCmdSet" id="CmdLocal" priority="0x0100" type="Button">
        <Strings>
          <ButtonText>ローカル変数に型を付ける (Qualify type / Alt+Q)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdMember" priority="0x0101" type="Button">
        <Strings>
          <ButtonText>メンバー変数として宣言する (Write member / Alt+W)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdAccessor" priority="0x0102" type="Button">
        <Strings>
          <ButtonText>ゲッター・セッターを作る (Getter / Alt+G)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdInclude" priority="0x0104" type="Button">
        <Strings>
          <ButtonText>#include を足す (Include / Alt+I)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdSync" priority="0x0105" type="Button">
        <Strings>
          <ButtonText>宣言と定義の引数を合わせる (Sync / Alt+S)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdCreate" priority="0x0106" type="Button">
        <Strings>
          <ButtonText>宣言・定義の相手を作る (Resolve / Alt+R)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdMove" priority="0x0109" type="Button">
        <Strings>
          <ButtonText>関数を ヘッダー ⇄ cpp に移す (Move / Alt+M)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdRename" priority="0x0108" type="Button">
        <Strings>
          <ButtonText>ファイル名をまとめて変える (Name / Alt+N)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidKCppAssistCmdSet" id="CmdErrorLog" priority="0x0107" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-ErrorLog (エラーログ)を開く</ButtonText>
        </Strings>
      </Button>
      <!-- 拡張機能 メニューに出るのは、設定画面を開くものと、エラーログを開くものの 2 つ -->
      <Button guid="guidKCppAssistCmdSet" id="CmdSettings" priority="0x0103" type="Button">
        <Parent guid="guidKCppAssistCmdSet" id="KCppAssistMenuGroup" />
        <Strings>
          <ButtonText>K-Cpp: 設定...</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdTidyProject" priority="0x0001"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistProjGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdUnusedProject" priority="0x0002"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistProjGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdTidyProject" priority="0x0001"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistSolnGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdUnusedProject" priority="0x0002"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistSolnGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdEncoding" priority="0x0003"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistProjGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdEncoding" priority="0x0003"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistSolnGroup" /></CommandPlacement>
    <CommandPlacement guid="guidKCppAssistCmdSet" id="CmdRefactor" priority="0x0001"><Parent guid="guidKCppAssistCmdSet" id="KCppAssistEditGroup" /></CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdLocal" editor="guidTextEditor" key1="Q" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdMember" editor="guidTextEditor" key1="W" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdAccessor" editor="guidTextEditor" key1="G" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdInclude" editor="guidTextEditor" key1="I" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdRename" editor="guidTextEditor" key1="N" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdSync" editor="guidTextEditor" key1="S" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdCreate" editor="guidTextEditor" key1="R" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdMove" editor="guidTextEditor" key1="M" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdForward" editor="guidTextEditor" key1="F" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdCtor" editor="guidTextEditor" key1="C" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdOverride" editor="guidTextEditor" key1="O" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdUsage" editor="guidTextEditor" key1="U" mod1="Alt" />
    <KeyBinding guid="guidKCppAssistCmdSet" id="CmdRefactor" editor="guidTextEditor" key1="X" mod1="Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidVsMainMenu" value="{D309F791-903F-11D0-9EFC-00A0C911004F}">
      <IDSymbol name="IDM_EXTENSIONS_MENU" value="0x0091" />
      <IDSymbol name="IDM_VS_CTXT_PROJNODE" value="0x0402" />
      <IDSymbol name="IDM_VS_CTXT_SOLNNODE" value="0x0403" />
      <IDSymbol name="IDM_VS_CTXT_CODEWIN" value="0x040D" />
    </GuidSymbol>

    <GuidSymbol name="guidVSStd97" value="{5EFC7975-14BC-11CF-9B2B-00AA00573819}" />
    <!-- キーの範囲「テキスト エディター」。グローバルにすると、Alt+F(ファイル)などのメニューを、エディターの外でも奪う -->
    <GuidSymbol name="guidTextEditor" value="{8B382828-6202-11d1-8870-0000F87579D2}" />

    <GuidSymbol name="guidKCppAssistPackage" value="{b2f6c1a8-3d47-4e09-9a5c-81e7d0f4b362}" />

