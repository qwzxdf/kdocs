    <GuidSymbol name="guidVSStd97" value="{5EFC7975-14BC-11CF-9B2B-00AA00573819}" />

    <GuidSymbol name="guidKCppAssistPackage" value="{b2f6c1a8-3d47-4e09-9a5c-81e7d0f4b362}" />

    <GuidSymbol name="guidKCppAssistCmdSet" value="{e5a93d17-0c82-4b6f-a1d4-6f27b8c30e95}">
      <IDSymbol name="KCppAssistMenuGroup" value="0x1000" />
